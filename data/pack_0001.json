{
 "sentences": [
  {
   "id": "S0001",
   "en": "I am a soccer fan.",
   "ja": "私はサッカーファンです。",
   "textbook": "New Horizon 1",
   "unit": "Unit 3",
   "grade": "中1",
   "difficulty": 1,
   "grammarIds": [
    "G001"
   ]
  },
  {
   "id": "S0002",
   "en": "I can see you tomorrow morning.",
   "ja": "明日の午前中（朝）ならお会いすることができます。",
   "grade": "高1",
   "difficulty": 2,
   "grammarIds": [
    "G003",
    "G007"
   ]
  },
  {
   "id": "S0003",
   "en": "You will be able to swim soon.",
   "ja": "あなたはすぐに泳げるようになるでしょう。",
   "grade": "高1",
   "difficulty": 3,
   "note": "willとbe able toの併用",
   "grammarIds": [
    "G004",
    "G005"
   ]
  },
  {
   "id": "S0004",
   "en": "She could play the violin at five.",
   "ja": "彼女は5歳でバイオリンが弾けた。",
   "grade": "高1",
   "difficulty": 3,
   "note": "at five は「5歳のとき」",
   "grammarIds": [
    "G006",
    "G007"
   ]
  },
  {
   "id": "S0005",
   "en": "You can enter if you have a ticket.",
   "ja": "チケットがあれば、入場できます。",
   "grade": "高1",
   "difficulty": 3,
   "note": "canは許可の意味",
   "grammarIds": [
    "G008",
    "G014"
   ]
  },
  {
   "id": "S0006",
   "en": "You can't park your car here.",
   "ja": "ここに駐車してはいけません。",
   "grade": "高1",
   "difficulty": 2,
   "note": "can'tは禁止。不可能ではない",
   "grammarIds": [
    "G009"
   ]
  },
  {
   "id": "S0007",
   "en": "Can I turn on the radio?",
   "ja": "ラジオをつけてもいいですか。",
   "grade": "高1",
   "difficulty": 2,
   "note": "Can I 〜? は自分がしてよいか尋ねる",
   "grammarIds": [
    "G010"
   ]
  },
  {
   "id": "S0008",
   "en": "Can you open the window?",
   "ja": "窓を開けてくれませんか？",
   "grade": "高1",
   "difficulty": 2,
   "note": "Can you 〜? は相手への依頼。S0007と対比",
   "grammarIds": [
    "G011"
   ]
  },
  {
   "id": "S0009",
   "en": "Could you lend me the book?",
   "ja": "その本を貸してもらえますか？",
   "grade": "高1",
   "difficulty": 3,
   "note": "lendは「貸す」。borrowと混同しやすい",
   "grammarIds": [
    "G012",
    "G015"
   ]
  },
  {
   "id": "S0010",
   "en": "May I use your bathroom?",
   "ja": "トイレをお借りしてもよろしいですか。",
   "grade": "高1",
   "difficulty": 2,
   "note": "May I 〜? はCan I 〜? より丁寧",
   "grammarIds": [
    "G013"
   ]
  }
 ],
